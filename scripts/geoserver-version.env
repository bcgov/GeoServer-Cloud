# Shared image tag for the wrapper and all five GeoServer component scripts.
# This is sourced as Bash configuration, not applied as a Kubernetes manifest.
# Change the default below to select the normal release for this repository.
# A nonempty environment override takes precedence, for example:
#   GEOSERVER_CLOUD_VERSION=<target-tag> ./scripts/manage-geoserver.sh deploy
# An unset or empty variable uses the default; export keeps child scripts aligned.
GEOSERVER_CLOUD_VERSION="${GEOSERVER_CLOUD_VERSION:-3.0.1.1}"
export GEOSERVER_CLOUD_VERSION
